From 32523f7a034dd70450aaec995ae6287ba99e9689 Mon Sep 17 00:00:00 2001
From: Romit Chatterjee <romit@alumnux.com>
Date: Mon, 31 Aug 2026 10:24:53 +0530
Subject: [PATCH] arm64: dts: imx8mm-evk: describe Murata Bluetooth

Upstream-Status: Inappropriate [Murata platform configuration]

---
 arch/arm64/boot/dts/freescale/imx8mm-evk-usd-wifi.dts | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/boot/dts/freescale/imx8mm-evk-usd-wifi.dts b/arch/arm64/boot/dts/freescale/imx8mm-evk-usd-wifi.dts
index e660727aaa58..c0eb559ff040 100644
--- a/arch/arm64/boot/dts/freescale/imx8mm-evk-usd-wifi.dts
+++ b/arch/arm64/boot/dts/freescale/imx8mm-evk-usd-wifi.dts
@@ -70,3 +70,11 @@ &usdhc1 {
 	status = "disabled";
 	/delete-node/ wifi_wake_host;
 };
+
+/* For Bluetooth@uSD-M.2 Adapter */
+&uart3 {
+	bluetooth {
+		compatible = "nxp,88w8987-bt";
+		fw-init-baudrate = <3000000>;
+	};
+};

diff --git a/arch/arm64/boot/dts/freescale/Makefile b/arch/arm64/boot/dts/freescale/Makefile
index bb6bc733c7e5..5cbb7d8365ab 100644
--- a/arch/arm64/boot/dts/freescale/Makefile
+++ b/arch/arm64/boot/dts/freescale/Makefile
@@ -969,6 +969,7 @@ DTC_FLAGS_imx95-15x15-evk-rpmsg := -@
 dtb-$(CONFIG_ARCH_MXC) += imx95-15x15-evk-rpmsg.dtb
 
 dtb-$(CONFIG_ARCH_MXC) += imx95-19x19-evk.dtb imx95-19x19-evk-lpspi-slave.dtb
+dtb-$(CONFIG_ARCH_MXC) += imx95-19x19-evk-sdio-m2.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx95-19x19-evk-tja1104-rgmii.dtb imx95-19x19-evk-tja1104-rmii.dtb
 dtb-$(CONFIG_ARCH_MXC) += imx95-19x19-evk-netc-rpmsg.dtb
 
diff --git a/arch/arm64/boot/dts/freescale/imx95-19x19-evk-sdio-m2.dts b/arch/arm64/boot/dts/freescale/imx95-19x19-evk-sdio-m2.dts
new file mode 100644
index 000000000000..eeb35943111a
--- /dev/null
+++ b/arch/arm64/boot/dts/freescale/imx95-19x19-evk-sdio-m2.dts
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright 2024 NXP
+ */
+
+/dts-v1/;
+
+#include "imx95-19x19-evk.dts"
+
+/ {
+        usdhc3_pwrseq: usdhc3_pwrseq {
+                 compatible = "mmc-pwrseq-simple";
+                 pinctrl-names = "default";
+                 pinctrl-0 = <&pinctrl_usdhc3_pwrseq>;
+                 post-power-on-delay-ms = <100>;
+        };	
+	
+	
+};
+
+&scmi_iomuxc {
+
+       pinctrl_usdhc3_pwrseq: usdhc3pwrseq {
+                fsl,pins = <
+                        IMX95_PAD_XSPI1_SCLK__GPIO5_IO_BIT9                     0x31e
+                >;
+       };
+
+       pinctrl_usdhc3: usdhc3grp {
+                fsl,pins = <
+                        IMX95_PAD_SD3_CLK__USDHC3_CLK                           0x158e
+                        IMX95_PAD_SD3_CMD__USDHC3_CMD                           0x138e
+                        IMX95_PAD_SD3_DATA0__USDHC3_DATA0                       0x138e
+                        IMX95_PAD_SD3_DATA1__USDHC3_DATA1                       0x138e
+                        IMX95_PAD_SD3_DATA2__USDHC3_DATA2                       0x138e
+                        IMX95_PAD_SD3_DATA3__USDHC3_DATA3                       0x138e
+                >;
+       };
+
+       pinctrl_usdhc3_100mhz: usdhc3-100mhzgrp {
+                fsl,pins = <
+                        IMX95_PAD_SD3_CLK__USDHC3_CLK                           0x158e
+                        IMX95_PAD_SD3_CMD__USDHC3_CMD                           0x138e
+                        IMX95_PAD_SD3_DATA0__USDHC3_DATA0                       0x138e
+                        IMX95_PAD_SD3_DATA1__USDHC3_DATA1                       0x138e
+                        IMX95_PAD_SD3_DATA2__USDHC3_DATA2                       0x138e
+                        IMX95_PAD_SD3_DATA3__USDHC3_DATA3                       0x138e
+                >;
+       };
+
+       pinctrl_usdhc3_200mhz: usdhc3-200mhzgrp {
+                fsl,pins = <
+                        IMX95_PAD_SD3_CLK__USDHC3_CLK                           0x15fe
+                        IMX95_PAD_SD3_CMD__USDHC3_CMD                           0x13fe
+                        IMX95_PAD_SD3_DATA0__USDHC3_DATA0                       0x13fe
+                        IMX95_PAD_SD3_DATA1__USDHC3_DATA1                       0x13fe
+                        IMX95_PAD_SD3_DATA2__USDHC3_DATA2                       0x13fe
+                        IMX95_PAD_SD3_DATA3__USDHC3_DATA3                       0x13fe
+                >;
+       };
+};
+
+&usdhc3 {
+        pinctrl-names = "default", "state_100mhz", "state_200mhz", "sleep";
+        pinctrl-0 = <&pinctrl_usdhc3>;
+        pinctrl-1 = <&pinctrl_usdhc3_100mhz>;
+        pinctrl-2 = <&pinctrl_usdhc3_200mhz>;
+        pinctrl-3 = <&pinctrl_usdhc3>;
+        mmc-pwrseq = <&usdhc3_pwrseq>;
+        vmmc-supply = <&reg_pcie0>;   //Both PCIE0 and USDHC3 use same power supply.
+        bus-width = <4>;
+        keep-power-in-suspend;
+        non-removable;
+        wakeup-source;
+        status = "okay";
+};
+
+&pcie0 {
+	status = "disable";
+};
