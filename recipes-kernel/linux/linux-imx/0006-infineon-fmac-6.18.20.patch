+bool brcmf_sdio_bus_sleep_state(struct brcmf_sdio *bus)
+{
+	unsigned long flags;
+	bool result;
+
+	read_lock_irqsave(&bus->sleep_lock, flags);
+	if (bus->sdiodev->kso_state == BRCMF_KSO_ON)
+		result = false;
+	else
+		result = true;
+	read_unlock_irqrestore(&bus->sleep_lock, flags);
+
+	return result;
