 			mrq->cmd->error = -EBUSY;
 			mmc_request_done(host, mrq);
 			return;
@@ -342,16 +377,28 @@ int mmc_start_request(struct mmc_host *host, struct mmc_request *mrq)
 
 	mmc_retune_hold(host);
 
-	if (mmc_card_removed(host->card))
