From f17d3772ccb130e291fb6808ec46c09e31626d87 Mon Sep 17 00:00:00 2001
From: Romit Chatterjee <romit@alumnux.com>
Date: Mon, 31 Aug 2026 10:24:00 +0530
Subject: [PATCH] ARM: dts: imx6ul: force Murata Wi-Fi VIO to 1.8V

Upstream-Status: Inappropriate [Murata platform configuration]

---
 arch/arm/boot/dts/nxp/imx/imx6ul-14x14-evk-btwifi.dts  | 5 +++++
 arch/arm/boot/dts/nxp/imx/imx6ull-14x14-evk-btwifi.dts | 5 +++++
 2 files changed, 10 insertions(+)

diff --git a/arch/arm/boot/dts/nxp/imx/imx6ul-14x14-evk-btwifi.dts b/arch/arm/boot/dts/nxp/imx/imx6ul-14x14-evk-btwifi.dts
index 4613799a97c7..c399517c0282 100644
--- a/arch/arm/boot/dts/nxp/imx/imx6ul-14x14-evk-btwifi.dts
+++ b/arch/arm/boot/dts/nxp/imx/imx6ul-14x14-evk-btwifi.dts
@@ -8,3 +8,8 @@
 
 #include "imx6ul-14x14-evk.dts"
 #include "imx6ul-evk-btwifi.dtsi"
+
+&usdhc1 {
+	pinctrl-assert-gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>; /* Force 1.8V VIO */
+	no-1-8-v;
+};
diff --git a/arch/arm/boot/dts/nxp/imx/imx6ull-14x14-evk-btwifi.dts b/arch/arm/boot/dts/nxp/imx/imx6ull-14x14-evk-btwifi.dts
index 8a0a85d2e197..83526e192d15 100644
--- a/arch/arm/boot/dts/nxp/imx/imx6ull-14x14-evk-btwifi.dts
+++ b/arch/arm/boot/dts/nxp/imx/imx6ull-14x14-evk-btwifi.dts
@@ -8,3 +8,8 @@
 
 #include "imx6ull-14x14-evk.dts"
 #include "imx6ul-evk-btwifi.dtsi"
+
+&usdhc1 {
+	pinctrl-assert-gpios = <&gpio1 5 GPIO_ACTIVE_HIGH>; /* Force 1.8V VIO */
+	no-1-8-v;
+};
